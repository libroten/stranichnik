<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:Stranichnik.Localization"
        x:Class="Stranichnik.Views.SetMasterPasswordDialog"
        Title="{x:Static localization:UiStrings.SetMasterPasswordTitle}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DialogButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialogButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton:focus">
            <Setter Property="Background" Value="{DynamicResource DialogButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent:focus">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonFocusBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
        </Style>
    </Window.Styles>

    <Border Padding="20"
            Background="{DynamicResource DialogBackgroundBrush}">
        <StackPanel Spacing="14">
            <TextBlock Text="{x:Static localization:UiStrings.SetMasterPasswordTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DialogTextPrimaryBrush}"/>

            <TextBlock Text="{x:Static localization:UiStrings.SetMasterPasswordWarning}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DialogTextSecondaryBrush}"/>

            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static localization:UiStrings.SetMasterPasswordPasswordLabel}"
                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                <TextBox x:Name="PasswordTextBox"
                         PasswordChar="*"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static localization:UiStrings.SetMasterPasswordRepeatPasswordLabel}"
                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                <TextBox x:Name="RepeatPasswordTextBox"
                         PasswordChar="*"/>
            </StackPanel>

            <TextBlock x:Name="ErrorTextBlock"
                       IsVisible="False"
                       Foreground="{DynamicResource TextErrorBrush}"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Classes="dialogButton"
                        Click="OnCancelClick">
                    <TextBlock Text="{x:Static localization:UiStrings.CommonCancel}"/>
                </Button>
                <Button Classes="dialogButton accent"
                        Click="OnCreateClick">
                    <TextBlock Text="{x:Static localization:UiStrings.CommonSave}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
