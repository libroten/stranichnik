<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:Stranichnik.Localization"
        xmlns:views="using:Stranichnik.Views"
        x:Class="Stranichnik.Views.SettingsDialog"
        Title="{x:Static localization:UiStrings.SettingsDialogTitle}"
        Width="520"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton">
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialogButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton:focus">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonFocusBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.danger">
            <Setter Property="Background" Value="{DynamicResource DialogDangerButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogDangerButtonBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogDangerButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogDangerButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.danger:focus">
            <Setter Property="Background" Value="{DynamicResource ActionDeleteBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogDangerButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="CheckBox.syncToggle">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                Background="Transparent"
                                BorderBrush="{DynamicResource FocusBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Path x:Name="CheckMark"
                                  Data="M4 9L8 13L14 5"
                                  Stroke="{DynamicResource TextOnAccentBrush}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  IsVisible="False"/>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.syncToggle:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
        </Style>
        <Style Selector="CheckBox.syncToggle:pointerover /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonFocusBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="CheckBox.syncToggle:checked /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource FocusBorderBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="CheckBox.syncToggle:checked /template/ Path#CheckMark">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource DialogBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel Margin="22"
                            Spacing="22"
                            Width="460"
                            HorizontalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Static localization:UiStrings.SettingsSecretBookmarksSectionTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogTextPrimaryBrush}"/>

                        <Border Height="1"
                                Background="{DynamicResource DialogInputBorderBrush}"/>

                        <StackPanel Spacing="14">
                            <TextBlock Text="{x:Static localization:UiStrings.SettingsSecretBookmarksDescription}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DialogTextSecondaryBrush}"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Static localization:UiStrings.SettingsSecretNewPasswordLabel}"
                                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                                <TextBox x:Name="NewMasterPasswordTextBox"
                                         PasswordChar="*"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Static localization:UiStrings.SettingsSecretRepeatPasswordLabel}"
                                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                                <TextBox x:Name="RepeatMasterPasswordTextBox"
                                         PasswordChar="*"/>
                            </StackPanel>

                            <views:StatusBanner x:Name="SecretPasswordStatusBanner"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Classes="dialogButton"
                                        Click="OnSaveSecretPasswordClick">
                                    <TextBlock Text="{x:Static localization:UiStrings.SettingsSecretSavePasswordAction}"/>
                                </Button>
                            </StackPanel>

                            <Border Height="1"
                                    Background="{DynamicResource DialogInputBorderBrush}"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Static localization:UiStrings.SettingsSecretResetDescription}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Classes="dialogButton danger"
                                            Click="OnResetSecretMasterPasswordClick">
                                        <TextBlock Text="{x:Static localization:UiStrings.SettingsSecretResetPasswordAction}"
                                                   TextWrapping="Wrap"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10"
                                Margin="0,42,0,0">
                        <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncSectionTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogTextPrimaryBrush}"/>

                        <Border Height="1"
                                Background="{DynamicResource DialogInputBorderBrush}"/>

                        <StackPanel Spacing="14">
                            <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncDescription}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DialogTextSecondaryBrush}"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncWebDavUrlLabel}"
                                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                                <TextBox x:Name="SyncWebDavUrlTextBox"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncUsernameLabel}"
                                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                                <TextBox x:Name="SyncUsernameTextBox"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncPasswordLabel}"
                                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                                <TextBox x:Name="SyncPasswordTextBox"
                                         PasswordChar="*"/>
                            </StackPanel>

                            <views:StatusBanner x:Name="SyncInsecureCredentialWarningBanner"/>

                            <views:StatusBanner x:Name="SyncStatusBanner"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="10">
                                <Button Classes="dialogButton"
                                        Width="220"
                                        Height="44"
                                        Click="OnTestSyncConnectionClick">
                                    <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncTestConnectionAction}"
                                               TextWrapping="Wrap"/>
                                </Button>
                                <Button Classes="dialogButton"
                                        Width="220"
                                        Height="44"
                                        Click="OnSaveSyncSettingsClick">
                                    <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncSaveAction}"
                                               TextWrapping="Wrap"/>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="SyncNowActionsPanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Classes="dialogButton"
                                        Width="220"
                                        Height="44"
                                        Click="OnSyncNowClick">
                                    <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncNowAction}"
                                               TextWrapping="Wrap"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Classes="dialogButton"
                                        Width="220"
                                        Height="44"
                                        Click="OnResetSyncSettingsClick">
                                    <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncResetAction}"
                                               TextWrapping="Wrap"/>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="SyncRemoteProblemsSection"
                                        IsVisible="False"
                                        Spacing="10">
                                <Border Height="1"
                                        Background="{DynamicResource DialogInputBorderBrush}"/>

                                <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncRemoteProblemsTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}"/>

                                <TextBlock Text="{x:Static localization:UiStrings.SettingsSyncRemoteProblemsDescription}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>

                                <Border MaxHeight="190"
                                        Padding="4"
                                        CornerRadius="6"
                                        BorderBrush="{DynamicResource DialogInputBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource DialogInputBackgroundBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="SyncRemoteProblemsList"
                                                    Spacing="4"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
