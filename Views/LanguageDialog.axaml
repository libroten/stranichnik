<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:Stranichnik.Localization"
        x:Class="Stranichnik.Views.LanguageDialog"
        Title="{x:Static localization:UiStrings.LanguageDialogTitle}"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">
    <Window.Styles>
        <Style Selector="Button.optionRow">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.optionRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.optionRow.selected">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
        </Style>
    </Window.Styles>

    <Border Padding="20"
            Background="{DynamicResource DialogBackgroundBrush}">
        <Border Background="{DynamicResource DialogButtonBackgroundBrush}"
                BorderBrush="{DynamicResource DialogButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,1,Auto">
                <Button x:Name="EnglishButton"
                        Grid.Row="0"
                        Classes="optionRow"
                        Click="OnEnglishClick">
                    <TextBlock Text="{x:Static localization:UiStrings.LanguageDialogEnglish}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="18"/>
                </Button>

                <Border Grid.Row="1"
                        Background="{DynamicResource DialogButtonBorderBrush}"/>

                <Button x:Name="RussianButton"
                        Grid.Row="2"
                        Classes="optionRow"
                        Click="OnRussianClick">
                    <TextBlock Text="{x:Static localization:UiStrings.LanguageDialogRussian}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="18"/>
                </Button>
            </Grid>
        </Border>
    </Border>
</Window>
