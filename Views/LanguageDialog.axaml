<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:Stranichnik.Localization"
        x:Class="Stranichnik.Views.LanguageDialog"
        Title="{x:Static localization:UiStrings.LanguageDialogTitle}"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">
    <Window.Styles>
        <Style Selector="Button.languageOption">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.languageOption:pointerover">
            <Setter Property="Background" Value="#EEF6FF"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
        </Style>
        <Style Selector="Button.languageOption.selected">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>
        <Style Selector="Button.dialogButton">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialogButton:pointerover">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
        </Style>
        <Style Selector="Button.dialogButton.accent">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>
        <Style Selector="Button.dialogButton.accent:pointerover">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
        </Style>
    </Window.Styles>

    <Border Padding="20"
            Background="#FFFFFF">
        <StackPanel Spacing="14">
            <TextBlock Text="{x:Static localization:UiStrings.LanguageDialogTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#1F2937"/>

            <StackPanel Spacing="8">
                <Button x:Name="EnglishButton"
                        Classes="languageOption"
                        Click="OnEnglishClick">
                    <TextBlock Text="{x:Static localization:UiStrings.LanguageDialogEnglish}"/>
                </Button>
                <Button x:Name="RussianButton"
                        Classes="languageOption"
                        Click="OnRussianClick">
                    <TextBlock Text="{x:Static localization:UiStrings.LanguageDialogRussian}"/>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Classes="dialogButton"
                        Click="OnCancelClick">
                    <TextBlock Text="{x:Static localization:UiStrings.CommonCancel}"/>
                </Button>
                <Button Classes="dialogButton accent"
                        Click="OnApplyClick">
                    <TextBlock Text="{x:Static localization:UiStrings.CommonSave}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
