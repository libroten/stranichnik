<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stranichnik.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Stranichnik.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Stranichnik"
        Width="900"
        Height="640"
        MinWidth="720"
        MinHeight="480">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:BookmarkFolderViewModel">
            <StackPanel>
                <Border Classes="treeRow folderRow"
                        Padding="8,6"
                        PointerPressed="OnFolderRowPointerPressed">
                    <Grid>
                        <Grid Classes="normalRowLayout"
                              ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExpansionGlyph}"
                                           Classes="folderGlyph"
                                           Width="14"
                                           FontSize="15"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}"
                                           Classes="folderTitle"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           MaxWidth="480"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Classes="rowActions"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                <Button Classes="actionButton"
                                        ToolTip.Tip="Редактировать">
                                    <TextBlock Classes="actionIcon" Text="✎"/>
                                </Button>
                                <Button Classes="actionButton"
                                        ToolTip.Tip="Удалить">
                                    <TextBlock Classes="actionIcon" Text="⌫"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Classes="overflowRowLayout"
                                    Orientation="Horizontal"
                                    Spacing="12">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExpansionGlyph}"
                                           Classes="folderGlyph"
                                           Width="14"
                                           FontSize="15"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}"
                                           Classes="folderTitle"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           MaxWidth="480"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Classes="rowActions"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                <Button Classes="actionButton"
                                        ToolTip.Tip="Редактировать">
                                    <TextBlock Classes="actionIcon" Text="✎"/>
                                </Button>
                                <Button Classes="actionButton"
                                        ToolTip.Tip="Удалить">
                                    <TextBlock Classes="actionIcon" Text="⌫"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Children}"
                              IsVisible="{Binding IsExpanded}"
                              Margin="28,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BookmarkViewModel">
            <Border Classes="treeRow bookmarkRow"
                    Padding="8,6">
                <Grid>
                    <Grid Classes="normalRowLayout"
                          ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Classes="bookmarkTitle"
                                       FontSize="14"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Classes="bookmarkUrl"
                                       FontSize="12"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Classes="rowActions"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Classes="actionButton"
                                    ToolTip.Tip="Открыть">
                                <TextBlock Classes="actionIcon" Text="↗"/>
                            </Button>
                            <Button Classes="actionButton"
                                    ToolTip.Tip="Редактировать">
                                <TextBlock Classes="actionIcon" Text="✎"/>
                            </Button>
                            <Button Classes="actionButton"
                                    ToolTip.Tip="Удалить">
                                <TextBlock Classes="actionIcon" Text="⌫"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Classes="overflowRowLayout"
                                Orientation="Horizontal"
                                Spacing="12">
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Classes="bookmarkTitle"
                                       FontSize="14"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Classes="bookmarkUrl"
                                       FontSize="12"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Classes="rowActions"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Classes="actionButton"
                                    ToolTip.Tip="Открыть">
                                <TextBlock Classes="actionIcon" Text="↗"/>
                            </Button>
                            <Button Classes="actionButton"
                                    ToolTip.Tip="Редактировать">
                                <TextBlock Classes="actionIcon" Text="✎"/>
                            </Button>
                            <Button Classes="actionButton"
                                    ToolTip.Tip="Удалить">
                                <TextBlock Classes="actionIcon" Text="⌫"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*" Background="#F7F8FA">
        <Border Padding="20,16"
                Background="#FFFFFF"
                BorderBrush="#E2E5EA"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="Страничник"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Менеджер закладок"
                           Foreground="#667085"/>
            </StackPanel>
        </Border>

        <Grid x:Name="BookmarksHost"
              Grid.Row="1"
              Margin="20">
        <Border Width="{Binding Bounds.Width, ElementName=BookmarksHost}"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Padding="12"
                Background="#FFFFFF"
                BorderBrush="#E2E5EA"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer x:Name="BookmarksScrollViewer"
                          Background="#FFFFFF"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Styles>
                    <Style Selector="Border.treeRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                    <Style Selector="Border.treeRow:pointerover">
                        <Setter Property="Background" Value="#EEF6FF"/>
                    </Style>
                    <Style Selector="StackPanel.rowActions">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </Style>
                    <Style Selector="Border.treeRow:pointerover StackPanel.rowActions">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                    <Style Selector="StackPanel.overflowRowLayout">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                    <Style Selector="ScrollViewer.hasHorizontalOverflow Grid.normalRowLayout">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                    <Style Selector="ScrollViewer.hasHorizontalOverflow StackPanel.overflowRowLayout">
                        <Setter Property="IsVisible" Value="True"/>
                    </Style>
                    <Style Selector="Button.actionButton">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="Button.actionButton:pointerover">
                        <Setter Property="Background" Value="#CFE7FF"/>
                        <Setter Property="BorderBrush" Value="#9CCFFF"/>
                    </Style>
                    <Style Selector="TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#3D4A5C"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button.actionButton:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#111827"/>
                    </Style>
                    <Style Selector="TextBlock.folderGlyph">
                        <Setter Property="Foreground" Value="#526071"/>
                    </Style>
                    <Style Selector="TextBlock.folderTitle">
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="TextBlock.bookmarkTitle">
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="TextBlock.bookmarkUrl">
                        <Setter Property="Foreground" Value="#667085"/>
                    </Style>
                </ScrollViewer.Styles>

                <ItemsControl MinWidth="{Binding Viewport.Width, ElementName=BookmarksScrollViewer}"
                              ItemsSource="{Binding Items}"/>
            </ScrollViewer>
        </Border>
        </Grid>
    </Grid>

</Window>
