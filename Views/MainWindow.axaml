<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stranichnik.ViewModels"
        xmlns:searching="using:Stranichnik.Searching"
        xmlns:localization="using:Stranichnik.Localization"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Stranichnik.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Stranichnik"
        Width="900"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        KeyDown="OnKeyDown">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <sys:TimeSpan x:Key="HoverTransitionDuration">0:0:0.10</sys:TimeSpan>
    </Window.Resources>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:BookmarkFolderViewModel">
            <Border Classes="folderContainer">
                <StackPanel>
                    <Border Classes="treeRow folderRow"
                            Classes.rootFolder="{Binding IsRoot}"
                            Classes.dragHover="{Binding IsDragHoverTarget}"
                            Classes.dragSource="{Binding IsDragSource}"
                            Classes.dragDimmed="{Binding IsDragDimmed}"
                            Padding="8,6"
                            PointerPressed="OnTreeRowPointerPressed"
                            PointerReleased="OnFolderRowPointerReleased">
                        <Grid>
                            <Grid Classes="normalRowLayout"
                                  ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExpansionGlyph}"
                                               Classes="folderGlyph"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}"
                                               Classes="folderTitle"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               MaxWidth="480"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Classes="rowActions"
                                            Orientation="Horizontal"
                                            MinHeight="28"
                                            Spacing="4">
                                    <Button Classes="actionButton addAction"
                                            Click="OnAddBookmarkClick"
                                            ToolTip.Tip="{x:Static localization:UiStrings.ActionAddBookmark}">
                                        <TextBlock Classes="actionIcon" Text="+"/>
                                    </Button>
                                    <Button Classes="actionButton addFolderAction"
                                            Click="OnAddFolderClick"
                                            ToolTip.Tip="{x:Static localization:UiStrings.ActionAddFolder}">
                                        <TextBlock Classes="actionIcon" Text="F"/>
                                    </Button>
                                    <Button Classes="actionButton editAction"
                                            IsVisible="{Binding CanShowActions}"
                                            Click="OnEditFolderClick"
                                            ToolTip.Tip="{x:Static localization:UiStrings.ActionEdit}">
                                        <TextBlock Classes="actionIcon" Text="✎"/>
                                    </Button>
                                    <Button Classes="actionButton deleteAction"
                                            IsVisible="{Binding CanShowActions}"
                                            Click="OnDeleteFolderClick"
                                            ToolTip.Tip="{x:Static localization:UiStrings.ActionDelete}">
                                        <TextBlock Classes="actionIcon" Text="⌫"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Classes="overflowRowLayout"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExpansionGlyph}"
                                               Classes="folderGlyph"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}"
                                               Classes="folderTitle"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               MaxWidth="480"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Classes="rowActions"
                                            Orientation="Horizontal"
                                            MinHeight="28"
                                            Spacing="4">
                                    <Button Classes="actionButton addAction"
                                            Click="OnAddBookmarkClick"
                                            ToolTip.Tip="{x:Static localization:UiStrings.ActionAddBookmark}">
                                        <TextBlock Classes="actionIcon" Text="+"/>
                                    </Button>
                                    <Button Classes="actionButton addFolderAction"
                                            Click="OnAddFolderClick"
                                            ToolTip.Tip="{x:Static localization:UiStrings.ActionAddFolder}">
                                        <TextBlock Classes="actionIcon" Text="F"/>
                                    </Button>
                                    <Button Classes="actionButton editAction"
                                            IsVisible="{Binding CanShowActions}"
                                            Click="OnEditFolderClick"
                                            ToolTip.Tip="{x:Static localization:UiStrings.ActionEdit}">
                                        <TextBlock Classes="actionIcon" Text="✎"/>
                                    </Button>
                                    <Button Classes="actionButton deleteAction"
                                            IsVisible="{Binding CanShowActions}"
                                            Click="OnDeleteFolderClick"
                                            ToolTip.Tip="{x:Static localization:UiStrings.ActionDelete}">
                                        <TextBlock Classes="actionIcon" Text="⌫"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="dropPlaceholder"
                            Classes.shown="{Binding IsDropPlaceholderVisible}"
                            Classes.active="{Binding IsDropPlaceholderActive}"
                            IsVisible="{Binding IsDropPlaceholderVisible}"
                            Margin="28,4,0,4">
                        <Rectangle Classes="dropPlaceholderFrame"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Children}"
                                  IsVisible="{Binding IsExpanded}"
                                  Margin="28,0,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:BookmarkViewModel">
            <Border Classes="treeRow bookmarkRow"
                    Classes.dragSource="{Binding IsDragSource}"
                    Classes.dragDimmed="{Binding IsDragDimmed}"
                    Padding="8,6"
                    PointerPressed="OnTreeRowPointerPressed"
                    PointerReleased="OnTreeRowPointerReleased">
                <Grid>
                    <Grid Classes="normalRowLayout"
                          ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Classes="bookmarkTitle"
                                       FontSize="14"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Classes="bookmarkUrl"
                                       FontSize="12"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Classes="rowActions"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Classes="actionButton openAction"
                                    Click="OnOpenBookmarkClick"
                                    ToolTip.Tip="{x:Static localization:UiStrings.ActionOpen}">
                                <TextBlock Classes="actionIcon" Text="↗"/>
                            </Button>
                            <Button Classes="actionButton editAction"
                                    Click="OnEditBookmarkClick"
                                    ToolTip.Tip="{x:Static localization:UiStrings.ActionEdit}">
                                <TextBlock Classes="actionIcon" Text="✎"/>
                            </Button>
                            <Button Classes="actionButton deleteAction"
                                    Click="OnDeleteBookmarkClick"
                                    ToolTip.Tip="{x:Static localization:UiStrings.ActionDelete}">
                                <TextBlock Classes="actionIcon" Text="⌫"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Classes="overflowRowLayout"
                                Orientation="Horizontal"
                                Spacing="12">
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Classes="bookmarkTitle"
                                       FontSize="14"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Classes="bookmarkUrl"
                                       FontSize="12"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Classes="rowActions"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Classes="actionButton openAction"
                                    Click="OnOpenBookmarkClick"
                                    ToolTip.Tip="{x:Static localization:UiStrings.ActionOpen}">
                                <TextBlock Classes="actionIcon" Text="↗"/>
                            </Button>
                            <Button Classes="actionButton editAction"
                                    Click="OnEditBookmarkClick"
                                    ToolTip.Tip="{x:Static localization:UiStrings.ActionEdit}">
                                <TextBlock Classes="actionIcon" Text="✎"/>
                            </Button>
                            <Button Classes="actionButton deleteAction"
                                    Click="OnDeleteBookmarkClick"
                                    ToolTip.Tip="{x:Static localization:UiStrings.ActionDelete}">
                                <TextBlock Classes="actionIcon" Text="⌫"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="searching:BookmarkSearchResultItem">
            <Border Classes="searchResultRow"
                    Padding="10,7">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Classes="bookmarkTitle"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Url}"
                                   Classes="bookmarkUrl"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Classes="rowActions"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <Button Classes="actionButton openAction"
                                Click="OnOpenSearchResultClick"
                                ToolTip.Tip="{x:Static localization:UiStrings.ActionOpen}">
                            <TextBlock Classes="actionIcon" Text="↗"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{DynamicResource AppTopBarBackgroundBrush}"
                BorderBrush="{DynamicResource AppTopBarBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="MenuBarRoot">
                <Grid.Styles>
                    <Style Selector="Button.menuBarButton">
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusAdorner" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="3">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      Padding="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.menuBarButton:pointerover">
                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="Button.menuBarButton.open">
                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="Border.menuPopup">
                        <Setter Property="MinWidth" Value="160"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource WorkAreaBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                    <Style Selector="Button.menuPopupItem">
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusAdorner" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      Padding="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.menuPopupItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="Button.menuPopupItem:pressed">
                        <Setter Property="Background" Value="{DynamicResource PressedBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="Border.menuPopupSeparator">
                        <Setter Property="Height" Value="1"/>
                        <Setter Property="Margin" Value="6,4"/>
                        <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
                    </Style>
                </Grid.Styles>

                <StackPanel Orientation="Horizontal"
                            Margin="4,2">
                    <Button x:Name="StranichnikMenuButton"
                            Classes="menuBarButton"
                            Click="OnStranichnikMenuClick"
                            PointerEntered="OnStranichnikMenuPointerEntered">
                        <TextBlock Text="{x:Static localization:UiStrings.MainMenuApp}"/>
                    </Button>
                    <Button x:Name="ServiceMenuButton"
                            Classes="menuBarButton"
                            Click="OnServiceMenuClick"
                            PointerEntered="OnServiceMenuPointerEntered">
                        <TextBlock Text="{x:Static localization:UiStrings.MainMenuService}"/>
                    </Button>
                </StackPanel>

                <primitives:Popup x:Name="StranichnikMenuPopup"
                                  PlacementTarget="{Binding ElementName=StranichnikMenuButton}"
                                  Placement="BottomEdgeAlignedLeft"
                                  VerticalOffset="6"
                                  IsLightDismissEnabled="True"
                                  OverlayDismissEventPassThrough="True"
                                  OverlayInputPassThroughElement="{Binding ElementName=MenuBarRoot}"
                                  Closed="OnMenuPopupClosed">
                    <Border Classes="menuPopup">
                        <StackPanel>
                            <Button Classes="menuPopupItem"
                                    Click="OnMenuPopupItemClick">
                                <TextBlock Text="{x:Static localization:UiStrings.MainMenuAppAbout}"/>
                            </Button>
                            <Border Classes="menuPopupSeparator"/>
                            <Button Classes="menuPopupItem"
                                    Click="OnMenuPopupItemClick">
                                <TextBlock Text="{x:Static localization:UiStrings.MainMenuAppSettings}"/>
                            </Button>
                            <Button Classes="menuPopupItem"
                                    Click="OnMenuPopupItemClick">
                                <TextBlock Text="{x:Static localization:UiStrings.MainMenuAppExit}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </primitives:Popup>

                <primitives:Popup x:Name="ServiceMenuPopup"
                                  PlacementTarget="{Binding ElementName=ServiceMenuButton}"
                                  Placement="BottomEdgeAlignedLeft"
                                  VerticalOffset="6"
                                  IsLightDismissEnabled="True"
                                  OverlayDismissEventPassThrough="True"
                                  OverlayInputPassThroughElement="{Binding ElementName=MenuBarRoot}"
                                  Closed="OnMenuPopupClosed">
                    <Border Classes="menuPopup">
                        <StackPanel>
                            <Button Classes="menuPopupItem"
                                    Click="OnAppearanceMenuClick">
                                <TextBlock Text="{x:Static localization:UiStrings.MainMenuServiceAppearance}"/>
                            </Button>
                            <Button Classes="menuPopupItem"
                                    Click="OnLanguageMenuClick">
                                <TextBlock Text="{x:Static localization:UiStrings.MainMenuServiceLanguage}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </primitives:Popup>
            </Grid>
        </Border>

        <Grid x:Name="BookmarksHost"
              Grid.Row="1"
              Margin="20">
        <Border Width="{Binding Bounds.Width, ElementName=BookmarksHost}"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Padding="12"
                Background="{DynamicResource WorkAreaBackgroundBrush}"
                BorderBrush="{DynamicResource WorkAreaBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="10">
                <Grid.Styles>
                    <Style Selector="Border.searchBoxContainer">
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Background" Value="{DynamicResource SearchBoxBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SearchBoxBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                    <Style Selector="Border.searchBoxContainer:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SearchBoxBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
                    </Style>
                    <Style Selector="TextBlock.searchIcon">
                        <Setter Property="Foreground" Value="{DynamicResource SearchIconBrush}"/>
                        <Setter Property="FontSize" Value="40"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="TextBox.searchBoxInput">
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
                        <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusAdorner" Value="{x:Null}"/>
                    </Style>
                    <Style Selector="TextBox.searchBoxInput:pointerover">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="TextBox.searchBoxInput:focus">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="TextBox.searchBoxInput /template/ Border#PART_BorderElement">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    <Style Selector="TextBox.searchBoxInput:pointerover /template/ Border#PART_BorderElement">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="TextBox.searchBoxInput:focus /template/ Border#PART_BorderElement">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="Button.searchClearButton">
                        <Setter Property="Width" Value="24"/>
                        <Setter Property="Height" Value="24"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource SearchClearButtonForegroundBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusAdorner" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="12">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.searchClearButton:pointerover">
                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="Border.searchResultsPanel">
                        <Setter Property="Background" Value="{DynamicResource WorkAreaBackgroundBrush}"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                    <Style Selector="Border.searchResultRow">
                        <Setter Property="Background" Value="{DynamicResource WorkAreaBackgroundBrush}"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background"
                                                 Duration="{StaticResource HoverTransitionDuration}"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border.searchResultRow:pointerover">
                        <Setter Property="Background" Value="{DynamicResource TreeRowHoverBackgroundBrush}"/>
                    </Style>
                    <Style Selector="Border.treeRow">
                        <Setter Property="Background" Value="{DynamicResource WorkAreaBackgroundBrush}"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background"
                                                 Duration="{StaticResource HoverTransitionDuration}"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border.folderRow">
                        <Setter Property="Background" Value="{DynamicResource FolderRowBackgroundBrush}"/>
                    </Style>
                    <Style Selector="Border.folderContainer">
                        <Setter Property="BorderBrush" Value="{DynamicResource FolderContainerBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1,0,0,1"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="0,8,0,12"/>
                    </Style>
                    <Style Selector="Border.treeRow:pointerover">
                        <Setter Property="Background" Value="{DynamicResource TreeRowHoverBackgroundBrush}"/>
                    </Style>
                    <Style Selector="Border.treeRow.dragSource">
                        <Setter Property="Background" Value="{DynamicResource DragSourceBackgroundBrush}"/>
                    </Style>
                    <Style Selector="Border.treeRow.dragDimmed">
                        <Setter Property="Opacity" Value="0.42"/>
                    </Style>
                    <Style Selector="Border.folderRow.dragHover">
                        <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder">
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="{StaticResource HoverTransitionDuration}"/>
                                <BrushTransition Property="Background"
                                                 Duration="{StaticResource HoverTransitionDuration}"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border.dropPlaceholder.shown">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder:pointerover">
                        <Setter Property="Background" Value="{DynamicResource DropPlaceholderHoverBackgroundBrush}"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder.active">
                        <Setter Property="Background" Value="{DynamicResource DropPlaceholderHoverBackgroundBrush}"/>
                    </Style>
                    <Style Selector="Rectangle.dropPlaceholderFrame">
                        <Setter Property="Stroke" Value="{DynamicResource DropPlaceholderBorderBrush}"/>
                        <Setter Property="StrokeThickness" Value="1"/>
                        <Setter Property="StrokeDashArray" Value="4,3"/>
                        <Setter Property="RadiusX" Value="4"/>
                        <Setter Property="RadiusY" Value="4"/>
                    </Style>
                    <Style Selector="StackPanel.rowActions">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="{StaticResource HoverTransitionDuration}"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border.treeRow:pointerover StackPanel.rowActions">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                    <Style Selector="Border.searchResultRow:pointerover StackPanel.rowActions">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                    <Style Selector="Border.folderRow.rootFolder StackPanel.rowActions">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                    <Style Selector="StackPanel.overflowRowLayout">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                    <Style Selector="ScrollViewer.hasHorizontalOverflow Grid.normalRowLayout">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                    <Style Selector="ScrollViewer.hasHorizontalOverflow StackPanel.overflowRowLayout">
                        <Setter Property="IsVisible" Value="True"/>
                    </Style>
                    <Style Selector="Button.actionButton">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                    <Style Selector="TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button.openAction">
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionOpenBrush}"/>
                    </Style>
                    <Style Selector="Button.addAction">
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionAddBookmarkBrush}"/>
                    </Style>
                    <Style Selector="Button.addFolderAction">
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionAddFolderBrush}"/>
                    </Style>
                    <Style Selector="Button.editAction">
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionEditBrush}"/>
                    </Style>
                    <Style Selector="Button.deleteAction">
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionDeleteBrush}"/>
                    </Style>
                    <Style Selector="Button.openAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionOpenBrush}"/>
                    </Style>
                    <Style Selector="Button.addAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionAddBookmarkBrush}"/>
                    </Style>
                    <Style Selector="Button.addFolderAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionAddFolderBrush}"/>
                    </Style>
                    <Style Selector="Button.editAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionEditBrush}"/>
                    </Style>
                    <Style Selector="Button.deleteAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionDeleteBrush}"/>
                    </Style>
                    <Style Selector="Button.openAction:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ActionOpenHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionOpenBrush}"/>
                    </Style>
                    <Style Selector="Button.openAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource ActionOpenHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionOpenBrush}"/>
                    </Style>
                    <Style Selector="Button.addAction:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ActionAddBookmarkHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionAddBookmarkBrush}"/>
                    </Style>
                    <Style Selector="Button.addAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource ActionAddBookmarkHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionAddBookmarkBrush}"/>
                    </Style>
                    <Style Selector="Button.addFolderAction:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ActionAddFolderHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionAddFolderBrush}"/>
                    </Style>
                    <Style Selector="Button.addFolderAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource ActionAddFolderHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionAddFolderBrush}"/>
                    </Style>
                    <Style Selector="Button.editAction:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ActionEditHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionEditBrush}"/>
                    </Style>
                    <Style Selector="Button.editAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource ActionEditHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionEditBrush}"/>
                    </Style>
                    <Style Selector="Button.deleteAction:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ActionDeleteHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionDeleteBrush}"/>
                    </Style>
                    <Style Selector="Button.deleteAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource ActionDeleteHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ActionDeleteBrush}"/>
                    </Style>
                    <Style Selector="Button.openAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionOpenBrush}"/>
                    </Style>
                    <Style Selector="Button.openAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionOpenBrush}"/>
                    </Style>
                    <Style Selector="Button.addAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionAddBookmarkBrush}"/>
                    </Style>
                    <Style Selector="Button.addAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionAddBookmarkBrush}"/>
                    </Style>
                    <Style Selector="Button.addFolderAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionAddFolderBrush}"/>
                    </Style>
                    <Style Selector="Button.addFolderAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionAddFolderBrush}"/>
                    </Style>
                    <Style Selector="Button.editAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionEditBrush}"/>
                    </Style>
                    <Style Selector="Button.editAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionEditBrush}"/>
                    </Style>
                    <Style Selector="Button.deleteAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionDeleteBrush}"/>
                    </Style>
                    <Style Selector="Button.deleteAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="{DynamicResource ActionDeleteBrush}"/>
                    </Style>
                    <Style Selector="TextBlock.folderGlyph">
                        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}"/>
                        <Setter Property="Width" Value="18"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="TextBlock.folderTitle">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="TextBlock.bookmarkTitle">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Style>
                    <Style Selector="TextBlock.bookmarkUrl">
                        <Setter Property="Foreground" Value="{DynamicResource UrlTextBrush}"/>
                        <Setter Property="TextDecorations">
                            <TextDecorationCollection>
                                <TextDecoration Location="Underline"
                                                StrokeDashArray="2,2"
                                                StrokeThickness="1"/>
                            </TextDecorationCollection>
                        </Setter>
                    </Style>
                    <Style Selector="TextBlock.bookmarkUrl:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource UrlHoverTextBrush}"/>
                        <Setter Property="TextDecorations">
                            <TextDecorationCollection>
                                <TextDecoration Location="Underline"
                                                Stroke="{DynamicResource UrlUnderlineBrush}"
                                                StrokeDashArray="2,2"
                                                StrokeThickness="1"/>
                            </TextDecorationCollection>
                        </Setter>
                    </Style>
                </Grid.Styles>

                <StackPanel Grid.Row="0"
                            Spacing="8">
                    <Border Classes="searchBoxContainer">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="6"
                              VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Classes="searchIcon"
                                       Text="⌕"/>
                            <TextBox Grid.Column="1"
                                     Classes="searchBoxInput"
                                     PlaceholderText="{x:Static localization:UiStrings.SearchPlaceholder}"
                                     Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2"
                                    Classes="searchClearButton"
                                    IsVisible="{Binding IsSearchActive}"
                                    Click="OnClearSearchClick"
                                    ToolTip.Tip="{x:Static localization:UiStrings.CommonCancel}">
                                <TextBlock Text="×"
                                           FontSize="16"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1"
                        Classes="searchResultsPanel"
                        IsVisible="{Binding IsSearchActive}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding HasSearchResults}">
                            <ItemsControl ItemsSource="{Binding SearchResults}"/>
                        </ScrollViewer>
                        <TextBlock Text="{x:Static localization:UiStrings.SearchNoMatches}"
                                   IsVisible="{Binding HasNoSearchResults}"
                                   Padding="10,8"
                                   Foreground="{DynamicResource SearchEmptyTextBrush}"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="BookmarksScrollViewer"
                              Grid.Row="1"
                              IsVisible="{Binding IsBookmarksTreeVisible}"
                              Background="{DynamicResource WorkAreaBackgroundBrush}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PointerPressed="OnBookmarksScrollPointerPressed"
                              PointerMoved="OnBookmarksScrollPointerMoved"
                              PointerReleased="OnBookmarksScrollPointerReleased"
                              PointerCaptureLost="OnBookmarksScrollPointerCaptureLost">
                    <ContentControl MinWidth="{Binding Viewport.Width, ElementName=BookmarksScrollViewer}"
                                    Content="{Binding RootFolder}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Canvas x:Name="DragGhostLayer"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Border x:Name="DragGhost"
                    IsVisible="False"
                    Width="320"
                    Padding="10,8"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="0.92">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="DragGhostTitle"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DragGhostUrl"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Canvas>
        </Grid>
    </Grid>

</Window>
