<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stranichnik.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Stranichnik.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Stranichnik"
        Width="900"
        Height="640"
        MinWidth="720"
        MinHeight="480">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:BookmarkFolderViewModel">
            <StackPanel>
                <Border Classes="treeRow folderRow"
                        Classes.dragHover="{Binding IsDragHoverTarget}"
                        Classes.dragSource="{Binding IsDragSource}"
                        Classes.dragDimmed="{Binding IsDragDimmed}"
                        Padding="8,6"
                        PointerPressed="OnTreeRowPointerPressed"
                        PointerReleased="OnFolderRowPointerReleased">
                    <Grid>
                        <Grid Classes="normalRowLayout"
                              ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExpansionGlyph}"
                                           Classes="folderGlyph"
                                           Width="14"
                                           FontSize="15"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}"
                                           Classes="folderTitle"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           MaxWidth="480"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Classes="rowActions"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                <Button Classes="actionButton editAction"
                                        ToolTip.Tip="Редактировать">
                                    <TextBlock Classes="actionIcon" Text="✎"/>
                                </Button>
                                <Button Classes="actionButton deleteAction"
                                        ToolTip.Tip="Удалить">
                                    <TextBlock Classes="actionIcon" Text="⌫"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Classes="overflowRowLayout"
                                    Orientation="Horizontal"
                                    Spacing="12">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding ExpansionGlyph}"
                                           Classes="folderGlyph"
                                           Width="14"
                                           FontSize="15"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}"
                                           Classes="folderTitle"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           MaxWidth="480"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Classes="rowActions"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                <Button Classes="actionButton editAction"
                                        ToolTip.Tip="Редактировать">
                                    <TextBlock Classes="actionIcon" Text="✎"/>
                                </Button>
                                <Button Classes="actionButton deleteAction"
                                        ToolTip.Tip="Удалить">
                                    <TextBlock Classes="actionIcon" Text="⌫"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="dropPlaceholder"
                        Classes.active="{Binding IsDropPlaceholderActive}"
                        IsVisible="{Binding IsDropPlaceholderVisible}"
                        Margin="28,4,0,4">
                    <Rectangle Classes="dropPlaceholderFrame"/>
                </Border>

                <ItemsControl ItemsSource="{Binding Children}"
                              IsVisible="{Binding IsExpanded}"
                              Margin="28,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BookmarkViewModel">
            <Border Classes="treeRow bookmarkRow"
                    Classes.dragSource="{Binding IsDragSource}"
                    Classes.dragDimmed="{Binding IsDragDimmed}"
                    Padding="8,6"
                    PointerPressed="OnTreeRowPointerPressed"
                    PointerReleased="OnTreeRowPointerReleased">
                <Grid>
                    <Grid Classes="normalRowLayout"
                          ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Classes="bookmarkTitle"
                                       FontSize="14"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Classes="bookmarkUrl"
                                       FontSize="12"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Classes="rowActions"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Classes="actionButton openAction"
                                    ToolTip.Tip="Открыть">
                                <TextBlock Classes="actionIcon" Text="↗"/>
                            </Button>
                            <Button Classes="actionButton editAction"
                                    ToolTip.Tip="Редактировать">
                                <TextBlock Classes="actionIcon" Text="✎"/>
                            </Button>
                            <Button Classes="actionButton deleteAction"
                                    ToolTip.Tip="Удалить">
                                <TextBlock Classes="actionIcon" Text="⌫"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Classes="overflowRowLayout"
                                Orientation="Horizontal"
                                Spacing="12">
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Classes="bookmarkTitle"
                                       FontSize="14"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Classes="bookmarkUrl"
                                       FontSize="12"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Classes="rowActions"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Classes="actionButton openAction"
                                    ToolTip.Tip="Открыть">
                                <TextBlock Classes="actionIcon" Text="↗"/>
                            </Button>
                            <Button Classes="actionButton editAction"
                                    ToolTip.Tip="Редактировать">
                                <TextBlock Classes="actionIcon" Text="✎"/>
                            </Button>
                            <Button Classes="actionButton deleteAction"
                                    ToolTip.Tip="Удалить">
                                <TextBlock Classes="actionIcon" Text="⌫"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*" Background="#F7F8FA">
        <Border Padding="20,16"
                Background="#FFFFFF"
                BorderBrush="#E2E5EA"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="Страничник"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Менеджер закладок"
                           Foreground="#667085"/>
            </StackPanel>
        </Border>

        <Grid x:Name="BookmarksHost"
              Grid.Row="1"
              Margin="20">
        <Border Width="{Binding Bounds.Width, ElementName=BookmarksHost}"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Padding="12"
                Background="#FFFFFF"
                BorderBrush="#E2E5EA"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer x:Name="BookmarksScrollViewer"
                          Background="#FFFFFF"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PointerPressed="OnBookmarksScrollPointerPressed"
                          PointerMoved="OnBookmarksScrollPointerMoved"
                          PointerReleased="OnBookmarksScrollPointerReleased"
                          PointerCaptureLost="OnBookmarksScrollPointerCaptureLost">
                <ScrollViewer.Styles>
                    <Style Selector="Border.treeRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                    <Style Selector="Border.treeRow:pointerover">
                        <Setter Property="Background" Value="#EEF6FF"/>
                    </Style>
                    <Style Selector="Border.treeRow.dragSource">
                        <Setter Property="Background" Value="#FEF3C7"/>
                    </Style>
                    <Style Selector="Border.treeRow.dragDimmed">
                        <Setter Property="Opacity" Value="0.42"/>
                    </Style>
                    <Style Selector="Border.folderRow.dragHover">
                        <Setter Property="Background" Value="#DBEAFE"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder">
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder:pointerover">
                        <Setter Property="Background" Value="#EEF6FF"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder.active">
                        <Setter Property="Background" Value="#DBEAFE"/>
                    </Style>
                    <Style Selector="Rectangle.dropPlaceholderFrame">
                        <Setter Property="Stroke" Value="#64748B"/>
                        <Setter Property="StrokeThickness" Value="1"/>
                        <Setter Property="StrokeDashArray" Value="4,3"/>
                        <Setter Property="RadiusX" Value="4"/>
                        <Setter Property="RadiusY" Value="4"/>
                    </Style>
                    <Style Selector="StackPanel.rowActions">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </Style>
                    <Style Selector="Border.treeRow:pointerover StackPanel.rowActions">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                    <Style Selector="StackPanel.overflowRowLayout">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                    <Style Selector="ScrollViewer.hasHorizontalOverflow Grid.normalRowLayout">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                    <Style Selector="ScrollViewer.hasHorizontalOverflow StackPanel.overflowRowLayout">
                        <Setter Property="IsVisible" Value="True"/>
                    </Style>
                    <Style Selector="Button.actionButton">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#3D4A5C"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button.openAction:pointerover">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="Button.editAction:pointerover">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="Button.deleteAction:pointerover">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="Button.openAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#2563EB"/>
                    </Style>
                    <Style Selector="Button.editAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#16A34A"/>
                    </Style>
                    <Style Selector="Button.deleteAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#DC2626"/>
                    </Style>
                    <Style Selector="TextBlock.folderGlyph">
                        <Setter Property="Foreground" Value="#526071"/>
                    </Style>
                    <Style Selector="TextBlock.folderTitle">
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="TextBlock.bookmarkTitle">
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="TextBlock.bookmarkUrl">
                        <Setter Property="Foreground" Value="#667085"/>
                        <Setter Property="TextDecorations">
                            <TextDecorationCollection>
                                <TextDecoration Location="Underline"
                                                StrokeDashArray="2,2"
                                                StrokeThickness="1"/>
                            </TextDecorationCollection>
                        </Setter>
                    </Style>
                    <Style Selector="TextBlock.bookmarkUrl:pointerover">
                        <Setter Property="Foreground" Value="#2563EB"/>
                        <Setter Property="TextDecorations">
                            <TextDecorationCollection>
                                <TextDecoration Location="Underline"
                                                Stroke="#2563EB"
                                                StrokeDashArray="2,2"
                                                StrokeThickness="1"/>
                            </TextDecorationCollection>
                        </Setter>
                    </Style>
                </ScrollViewer.Styles>

                <StackPanel MinWidth="{Binding Viewport.Width, ElementName=BookmarksScrollViewer}">
                    <Border Classes="dropPlaceholder"
                            Classes.active="{Binding IsRootDropPlaceholderActive}"
                            IsVisible="{Binding IsRootDropPlaceholderVisible}"
                            Margin="0,4">
                        <Rectangle Classes="dropPlaceholderFrame"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Canvas x:Name="DragGhostLayer"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Border x:Name="DragGhost"
                    IsVisible="False"
                    Width="320"
                    Padding="10,8"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="0.92">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="DragGhostTitle"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DragGhostUrl"
                               FontSize="11"
                               Foreground="#667085"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Canvas>
        </Grid>
    </Grid>

</Window>
