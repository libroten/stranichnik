<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Stranichnik.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Stranichnik.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Stranichnik"
        Width="900"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        KeyDown="OnKeyDown">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <sys:TimeSpan x:Key="HoverTransitionDuration">0:0:0.10</sys:TimeSpan>
    </Window.Resources>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:BookmarkFolderViewModel">
            <Border Classes="folderContainer">
                <StackPanel>
                    <Border Classes="treeRow folderRow"
                            Classes.rootFolder="{Binding IsRoot}"
                            Classes.dragHover="{Binding IsDragHoverTarget}"
                            Classes.dragSource="{Binding IsDragSource}"
                            Classes.dragDimmed="{Binding IsDragDimmed}"
                            Padding="8,6"
                            PointerPressed="OnTreeRowPointerPressed"
                            PointerReleased="OnFolderRowPointerReleased">
                        <Grid>
                            <Grid Classes="normalRowLayout"
                                  ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExpansionGlyph}"
                                               Classes="folderGlyph"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}"
                                               Classes="folderTitle"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               MaxWidth="480"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Classes="rowActions"
                                            Orientation="Horizontal"
                                            MinHeight="28"
                                            Spacing="4">
                                    <Button Classes="actionButton addAction"
                                            Click="OnAddBookmarkClick"
                                            ToolTip.Tip="Добавить закладку">
                                        <TextBlock Classes="actionIcon" Text="+"/>
                                    </Button>
                                    <Button Classes="actionButton addFolderAction"
                                            Click="OnAddFolderClick"
                                            ToolTip.Tip="Добавить папку">
                                        <TextBlock Classes="actionIcon" Text="F"/>
                                    </Button>
                                    <Button Classes="actionButton editAction"
                                            IsVisible="{Binding CanShowActions}"
                                            Click="OnEditFolderClick"
                                            ToolTip.Tip="Редактировать">
                                        <TextBlock Classes="actionIcon" Text="✎"/>
                                    </Button>
                                    <Button Classes="actionButton deleteAction"
                                            IsVisible="{Binding CanShowActions}"
                                            Click="OnDeleteFolderClick"
                                            ToolTip.Tip="Удалить">
                                        <TextBlock Classes="actionIcon" Text="⌫"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Classes="overflowRowLayout"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExpansionGlyph}"
                                               Classes="folderGlyph"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}"
                                               Classes="folderTitle"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               MaxWidth="480"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Classes="rowActions"
                                            Orientation="Horizontal"
                                            MinHeight="28"
                                            Spacing="4">
                                    <Button Classes="actionButton addAction"
                                            Click="OnAddBookmarkClick"
                                            ToolTip.Tip="Добавить закладку">
                                        <TextBlock Classes="actionIcon" Text="+"/>
                                    </Button>
                                    <Button Classes="actionButton addFolderAction"
                                            Click="OnAddFolderClick"
                                            ToolTip.Tip="Добавить папку">
                                        <TextBlock Classes="actionIcon" Text="F"/>
                                    </Button>
                                    <Button Classes="actionButton editAction"
                                            IsVisible="{Binding CanShowActions}"
                                            Click="OnEditFolderClick"
                                            ToolTip.Tip="Редактировать">
                                        <TextBlock Classes="actionIcon" Text="✎"/>
                                    </Button>
                                    <Button Classes="actionButton deleteAction"
                                            IsVisible="{Binding CanShowActions}"
                                            Click="OnDeleteFolderClick"
                                            ToolTip.Tip="Удалить">
                                        <TextBlock Classes="actionIcon" Text="⌫"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="dropPlaceholder"
                            Classes.shown="{Binding IsDropPlaceholderVisible}"
                            Classes.active="{Binding IsDropPlaceholderActive}"
                            IsVisible="{Binding IsDropPlaceholderVisible}"
                            Margin="28,4,0,4">
                        <Rectangle Classes="dropPlaceholderFrame"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Children}"
                                  IsVisible="{Binding IsExpanded}"
                                  Margin="28,0,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:BookmarkViewModel">
            <Border Classes="treeRow bookmarkRow"
                    Classes.dragSource="{Binding IsDragSource}"
                    Classes.dragDimmed="{Binding IsDragDimmed}"
                    Padding="8,6"
                    PointerPressed="OnTreeRowPointerPressed"
                    PointerReleased="OnTreeRowPointerReleased">
                <Grid>
                    <Grid Classes="normalRowLayout"
                          ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Classes="bookmarkTitle"
                                       FontSize="14"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Classes="bookmarkUrl"
                                       FontSize="12"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Classes="rowActions"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Classes="actionButton openAction"
                                    Click="OnOpenBookmarkClick"
                                    ToolTip.Tip="Открыть">
                                <TextBlock Classes="actionIcon" Text="↗"/>
                            </Button>
                            <Button Classes="actionButton editAction"
                                    Click="OnEditBookmarkClick"
                                    ToolTip.Tip="Редактировать">
                                <TextBlock Classes="actionIcon" Text="✎"/>
                            </Button>
                            <Button Classes="actionButton deleteAction"
                                    Click="OnDeleteBookmarkClick"
                                    ToolTip.Tip="Удалить">
                                <TextBlock Classes="actionIcon" Text="⌫"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Classes="overflowRowLayout"
                                Orientation="Horizontal"
                                Spacing="12">
                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       Classes="bookmarkTitle"
                                       FontSize="14"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Classes="bookmarkUrl"
                                       FontSize="12"
                                       MaxWidth="480"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Classes="rowActions"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Classes="actionButton openAction"
                                    Click="OnOpenBookmarkClick"
                                    ToolTip.Tip="Открыть">
                                <TextBlock Classes="actionIcon" Text="↗"/>
                            </Button>
                            <Button Classes="actionButton editAction"
                                    Click="OnEditBookmarkClick"
                                    ToolTip.Tip="Редактировать">
                                <TextBlock Classes="actionIcon" Text="✎"/>
                            </Button>
                            <Button Classes="actionButton deleteAction"
                                    Click="OnDeleteBookmarkClick"
                                    ToolTip.Tip="Удалить">
                                <TextBlock Classes="actionIcon" Text="⌫"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Background="#F7F8FA"
          RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2E5EA"
                BorderThickness="0,0,0,1">
            <Grid x:Name="MenuBarRoot">
                <Grid.Styles>
                    <Style Selector="Button.menuBarButton">
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusAdorner" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="3">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      Padding="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.menuBarButton:pointerover">
                        <Setter Property="Background" Value="#EEF6FF"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="Button.menuBarButton.open">
                        <Setter Property="Background" Value="#EEF6FF"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="Border.menuPopup">
                        <Setter Property="MinWidth" Value="160"/>
                        <Setter Property="Padding" Value="4"/>
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="BorderBrush" Value="#D8DEE8"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                    <Style Selector="Button.menuPopupItem">
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusAdorner" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      Padding="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="Button.menuPopupItem:pointerover">
                        <Setter Property="Background" Value="#EEF6FF"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="Button.menuPopupItem:pressed">
                        <Setter Property="Background" Value="#DBEAFE"/>
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="Border.menuPopupSeparator">
                        <Setter Property="Height" Value="1"/>
                        <Setter Property="Margin" Value="6,4"/>
                        <Setter Property="Background" Value="#E2E5EA"/>
                    </Style>
                </Grid.Styles>

                <StackPanel Orientation="Horizontal"
                            Margin="4,2">
                    <Button x:Name="StranichnikMenuButton"
                            Classes="menuBarButton"
                            Click="OnStranichnikMenuClick"
                            PointerEntered="OnStranichnikMenuPointerEntered">
                        Stranichnik
                    </Button>
                    <Button x:Name="ServiceMenuButton"
                            Classes="menuBarButton"
                            Click="OnServiceMenuClick"
                            PointerEntered="OnServiceMenuPointerEntered">
                        Сервис
                    </Button>
                </StackPanel>

                <primitives:Popup x:Name="StranichnikMenuPopup"
                                  PlacementTarget="{Binding ElementName=StranichnikMenuButton}"
                                  Placement="BottomEdgeAlignedLeft"
                                  VerticalOffset="6"
                                  IsLightDismissEnabled="True"
                                  OverlayDismissEventPassThrough="True"
                                  OverlayInputPassThroughElement="{Binding ElementName=MenuBarRoot}"
                                  Closed="OnMenuPopupClosed">
                    <Border Classes="menuPopup">
                        <StackPanel>
                            <Button Classes="menuPopupItem"
                                    Click="OnMenuPopupItemClick">
                                О программе
                            </Button>
                            <Border Classes="menuPopupSeparator"/>
                            <Button Classes="menuPopupItem"
                                    Click="OnMenuPopupItemClick">
                                Настройки
                            </Button>
                            <Button Classes="menuPopupItem"
                                    Click="OnMenuPopupItemClick">
                                Выход
                            </Button>
                        </StackPanel>
                    </Border>
                </primitives:Popup>

                <primitives:Popup x:Name="ServiceMenuPopup"
                                  PlacementTarget="{Binding ElementName=ServiceMenuButton}"
                                  Placement="BottomEdgeAlignedLeft"
                                  VerticalOffset="6"
                                  IsLightDismissEnabled="True"
                                  OverlayDismissEventPassThrough="True"
                                  OverlayInputPassThroughElement="{Binding ElementName=MenuBarRoot}"
                                  Closed="OnMenuPopupClosed">
                    <Border Classes="menuPopup">
                        <StackPanel>
                            <Button Classes="menuPopupItem"
                                    Click="OnMenuPopupItemClick">
                                Внешний вид
                            </Button>
                            <Button Classes="menuPopupItem"
                                    Click="OnMenuPopupItemClick">
                                Язык
                            </Button>
                        </StackPanel>
                    </Border>
                </primitives:Popup>
            </Grid>
        </Border>

        <Grid x:Name="BookmarksHost"
              Grid.Row="1"
              Margin="20">
        <Border Width="{Binding Bounds.Width, ElementName=BookmarksHost}"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Padding="12"
                Background="#FFFFFF"
                BorderBrush="#E2E5EA"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer x:Name="BookmarksScrollViewer"
                          Background="#FFFFFF"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PointerPressed="OnBookmarksScrollPointerPressed"
                          PointerMoved="OnBookmarksScrollPointerMoved"
                          PointerReleased="OnBookmarksScrollPointerReleased"
                          PointerCaptureLost="OnBookmarksScrollPointerCaptureLost">
                <ScrollViewer.Styles>
                    <Style Selector="Border.treeRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background"
                                                 Duration="{StaticResource HoverTransitionDuration}"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border.folderRow">
                        <Setter Property="Background" Value="#EEF2F7"/>
                    </Style>
                    <Style Selector="Border.folderContainer">
                        <Setter Property="BorderBrush" Value="#EEF2F7"/>
                        <Setter Property="BorderThickness" Value="1,0,0,1"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Margin" Value="0,8,0,12"/>
                    </Style>
                    <Style Selector="Border.treeRow:pointerover">
                        <Setter Property="Background" Value="#EEF6FF"/>
                    </Style>
                    <Style Selector="Border.treeRow.dragSource">
                        <Setter Property="Background" Value="#FEF3C7"/>
                    </Style>
                    <Style Selector="Border.treeRow.dragDimmed">
                        <Setter Property="Opacity" Value="0.42"/>
                    </Style>
                    <Style Selector="Border.folderRow.dragHover">
                        <Setter Property="Background" Value="#DBEAFE"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder">
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="4"/>
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="{StaticResource HoverTransitionDuration}"/>
                                <BrushTransition Property="Background"
                                                 Duration="{StaticResource HoverTransitionDuration}"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border.dropPlaceholder.shown">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder:pointerover">
                        <Setter Property="Background" Value="#EEF6FF"/>
                    </Style>
                    <Style Selector="Border.dropPlaceholder.active">
                        <Setter Property="Background" Value="#DBEAFE"/>
                    </Style>
                    <Style Selector="Rectangle.dropPlaceholderFrame">
                        <Setter Property="Stroke" Value="#64748B"/>
                        <Setter Property="StrokeThickness" Value="1"/>
                        <Setter Property="StrokeDashArray" Value="4,3"/>
                        <Setter Property="RadiusX" Value="4"/>
                        <Setter Property="RadiusY" Value="4"/>
                    </Style>
                    <Style Selector="StackPanel.rowActions">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <DoubleTransition Property="Opacity"
                                                  Duration="{StaticResource HoverTransitionDuration}"/>
                            </Transitions>
                        </Setter>
                    </Style>
                    <Style Selector="Border.treeRow:pointerover StackPanel.rowActions">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                    <Style Selector="Border.folderRow.rootFolder StackPanel.rowActions">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                    </Style>
                    <Style Selector="StackPanel.overflowRowLayout">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                    <Style Selector="ScrollViewer.hasHorizontalOverflow Grid.normalRowLayout">
                        <Setter Property="IsVisible" Value="False"/>
                    </Style>
                    <Style Selector="ScrollViewer.hasHorizontalOverflow StackPanel.overflowRowLayout">
                        <Setter Property="IsVisible" Value="True"/>
                    </Style>
                    <Style Selector="Button.actionButton">
                        <Setter Property="Width" Value="28"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                    <Style Selector="TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#3D4A5C"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="Button.openAction">
                        <Setter Property="BorderBrush" Value="#2563EB"/>
                    </Style>
                    <Style Selector="Button.addAction">
                        <Setter Property="BorderBrush" Value="#16A34A"/>
                    </Style>
                    <Style Selector="Button.addFolderAction">
                        <Setter Property="BorderBrush" Value="#0284C7"/>
                    </Style>
                    <Style Selector="Button.editAction">
                        <Setter Property="BorderBrush" Value="#CA8A04"/>
                    </Style>
                    <Style Selector="Button.deleteAction">
                        <Setter Property="BorderBrush" Value="#DC2626"/>
                    </Style>
                    <Style Selector="Button.openAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#2563EB"/>
                    </Style>
                    <Style Selector="Button.addAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#16A34A"/>
                    </Style>
                    <Style Selector="Button.addFolderAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#0284C7"/>
                    </Style>
                    <Style Selector="Button.editAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#CA8A04"/>
                    </Style>
                    <Style Selector="Button.deleteAction /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#DC2626"/>
                    </Style>
                    <Style Selector="Button.openAction:pointerover">
                        <Setter Property="Background" Value="#DBEAFE"/>
                        <Setter Property="BorderBrush" Value="#2563EB"/>
                    </Style>
                    <Style Selector="Button.openAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#DBEAFE"/>
                        <Setter Property="BorderBrush" Value="#2563EB"/>
                    </Style>
                    <Style Selector="Button.addAction:pointerover">
                        <Setter Property="Background" Value="#F0FDF4"/>
                        <Setter Property="BorderBrush" Value="#16A34A"/>
                    </Style>
                    <Style Selector="Button.addAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#F0FDF4"/>
                        <Setter Property="BorderBrush" Value="#16A34A"/>
                    </Style>
                    <Style Selector="Button.addFolderAction:pointerover">
                        <Setter Property="Background" Value="#E0F2FE"/>
                        <Setter Property="BorderBrush" Value="#0284C7"/>
                    </Style>
                    <Style Selector="Button.addFolderAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#E0F2FE"/>
                        <Setter Property="BorderBrush" Value="#0284C7"/>
                    </Style>
                    <Style Selector="Button.editAction:pointerover">
                        <Setter Property="Background" Value="#FFFBEB"/>
                        <Setter Property="BorderBrush" Value="#CA8A04"/>
                    </Style>
                    <Style Selector="Button.editAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#FFFBEB"/>
                        <Setter Property="BorderBrush" Value="#CA8A04"/>
                    </Style>
                    <Style Selector="Button.deleteAction:pointerover">
                        <Setter Property="Background" Value="#FEF2F2"/>
                        <Setter Property="BorderBrush" Value="#DC2626"/>
                    </Style>
                    <Style Selector="Button.deleteAction:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#FEF2F2"/>
                        <Setter Property="BorderBrush" Value="#DC2626"/>
                    </Style>
                    <Style Selector="Button.openAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#2563EB"/>
                    </Style>
                    <Style Selector="Button.openAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#2563EB"/>
                    </Style>
                    <Style Selector="Button.addAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#16A34A"/>
                    </Style>
                    <Style Selector="Button.addAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#16A34A"/>
                    </Style>
                    <Style Selector="Button.addFolderAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#0284C7"/>
                    </Style>
                    <Style Selector="Button.addFolderAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#0284C7"/>
                    </Style>
                    <Style Selector="Button.editAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#CA8A04"/>
                    </Style>
                    <Style Selector="Button.editAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#CA8A04"/>
                    </Style>
                    <Style Selector="Button.deleteAction TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#DC2626"/>
                    </Style>
                    <Style Selector="Button.deleteAction:pointerover TextBlock.actionIcon">
                        <Setter Property="Foreground" Value="#DC2626"/>
                    </Style>
                    <Style Selector="TextBlock.folderGlyph">
                        <Setter Property="Foreground" Value="#526071"/>
                        <Setter Property="Width" Value="18"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="TextBlock.folderTitle">
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="TextBlock.bookmarkTitle">
                        <Setter Property="Foreground" Value="#1F2937"/>
                    </Style>
                    <Style Selector="TextBlock.bookmarkUrl">
                        <Setter Property="Foreground" Value="#667085"/>
                        <Setter Property="TextDecorations">
                            <TextDecorationCollection>
                                <TextDecoration Location="Underline"
                                                StrokeDashArray="2,2"
                                                StrokeThickness="1"/>
                            </TextDecorationCollection>
                        </Setter>
                    </Style>
                    <Style Selector="TextBlock.bookmarkUrl:pointerover">
                        <Setter Property="Foreground" Value="#2563EB"/>
                        <Setter Property="TextDecorations">
                            <TextDecorationCollection>
                                <TextDecoration Location="Underline"
                                                Stroke="#2563EB"
                                                StrokeDashArray="2,2"
                                                StrokeThickness="1"/>
                            </TextDecorationCollection>
                        </Setter>
                    </Style>
                </ScrollViewer.Styles>

                <ContentControl MinWidth="{Binding Viewport.Width, ElementName=BookmarksScrollViewer}"
                                Content="{Binding RootFolder}"/>
            </ScrollViewer>
        </Border>

        <Canvas x:Name="DragGhostLayer"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Border x:Name="DragGhost"
                    IsVisible="False"
                    Width="320"
                    Padding="10,8"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="0.92">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="DragGhostTitle"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1F2937"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DragGhostUrl"
                               FontSize="11"
                               Foreground="#667085"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Canvas>
        </Grid>
    </Grid>

</Window>
