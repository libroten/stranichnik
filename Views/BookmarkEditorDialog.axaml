<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:Stranichnik.Localization"
        xmlns:views="using:Stranichnik.Views"
        x:Class="Stranichnik.Views.BookmarkEditorDialog"
        Title="{x:Static localization:UiStrings.BookmarkEditorAddBookmarkTitle}"
        Width="420"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}"
        KeyDown="OnKeyDown">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DialogButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialogButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton:focus">
            <Setter Property="Background" Value="{DynamicResource DialogButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent:focus">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonFocusBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.metadataSuggestion">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.metadataSuggestion:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource UrlHoverTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.metadataSuggestionText">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextDecorations">
                <TextDecorationCollection>
                    <TextDecoration Location="Underline"
                                    Stroke="{DynamicResource TextMutedBrush}"
                                    StrokeDashArray="2,2"
                                    StrokeThickness="1"/>
                </TextDecorationCollection>
            </Setter>
        </Style>
        <Style Selector="Button.metadataSuggestion:pointerover TextBlock.metadataSuggestionText">
            <Setter Property="Foreground" Value="{DynamicResource UrlHoverTextBrush}"/>
            <Setter Property="TextDecorations">
                <TextDecorationCollection>
                    <TextDecoration Location="Underline"
                                    Stroke="{DynamicResource UrlUnderlineBrush}"
                                    StrokeDashArray="2,2"
                                    StrokeThickness="1"/>
                </TextDecorationCollection>
            </Setter>
        </Style>
        <Style Selector="ProgressBar.metadataLoading">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.iconChoice">
            <Setter Property="Width" Value="86"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.iconChoice:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogButtonHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.iconChoice.selected">
            <Setter Property="Background" Value="{DynamicResource ActionAddBookmarkHoverBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ActionAddBookmarkBrush}"/>
        </Style>
        <Style Selector="Border.iconPreview">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource DialogBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.iconPreviewGlyph">
            <Setter Property="Foreground" Value="{DynamicResource ActionAddBookmarkBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.iconChoiceLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="68"/>
        </Style>
        <Style Selector="CheckBox.secretToggle">
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                Background="{DynamicResource DialogInputBackgroundBrush}"
                                BorderBrush="{DynamicResource DialogInputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Path x:Name="CheckMark"
                                  Data="M4 9L8 13L14 5"
                                  Stroke="{DynamicResource TextOnAccentBrush}"
                                  StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  IsVisible="False"/>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.secretToggle:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="CheckBox.secretToggle:checked /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
        </Style>
        <Style Selector="CheckBox.secretToggle:checked /template/ Path#CheckMark">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </Window.Styles>

    <Border Padding="20"
            Background="{DynamicResource DialogBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <TextBlock x:Name="DialogTitleTextBlock"
                           Text="{x:Static localization:UiStrings.BookmarkEditorAddBookmarkTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DialogTextPrimaryBrush}"/>

                <CheckBox x:Name="SecretCheckBox"
                          Classes="secretToggle"
                          IsVisible="False"
                          Click="OnSecretCheckClick">
                    <TextBlock Text="{x:Static localization:UiStrings.BookmarkEditorSecretBookmarkLabel}"/>
                </CheckBox>

                <StackPanel x:Name="IconFieldPanel"
                            Spacing="6">
                <TextBlock Text="{x:Static localization:UiStrings.BookmarkEditorIconLabel}"
                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                <WrapPanel>
                    <Button x:Name="CurrentIconButton"
                            Classes="iconChoice"
                            Margin="0,0,8,8"
                            Click="OnCurrentIconClick">
                        <StackPanel Spacing="6"
                                    HorizontalAlignment="Center">
                            <Border Classes="iconPreview">
                                <Image x:Name="CurrentIconImage"
                                       Width="22"
                                       Height="22"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="CurrentIconTextBlock"
                                       Classes="iconChoiceLabel"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FaviconIconButton"
                            Classes="iconChoice"
                            Margin="0,0,8,8"
                            IsVisible="False"
                            Click="OnFaviconIconClick">
                        <StackPanel Spacing="6"
                                    HorizontalAlignment="Center">
                            <Border Classes="iconPreview">
                                <Image x:Name="FaviconIconImage"
                                       Width="22"
                                       Height="22"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="FaviconIconTextBlock"
                                       Classes="iconChoiceLabel"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DefaultIconButton"
                            Classes="iconChoice"
                            Margin="0,0,8,8"
                            Click="OnDefaultIconClick">
                        <StackPanel Spacing="6"
                                    HorizontalAlignment="Center">
                            <Border Classes="iconPreview">
                                <Grid>
                                    <Viewbox x:Name="DefaultBookmarkIconPreview"
                                             Width="22"
                                             Height="22"
                                             IsHitTestVisible="False">
                                        <Canvas Width="256"
                                                Height="256">
                                            <Path Data="M74 36C74 25.51 82.51 17 93 17H163C173.49 17 182 25.51 182 36V222C182 228.34 174.62 231.83 169.71 227.81L132.75 197.58C129.98 195.31 126.02 195.31 123.25 197.58L86.29 227.81C81.38 231.83 74 228.34 74 222V36Z"
                                                  Fill="{DynamicResource ActionOpenBrush}"/>
                                            <Path Data="M89 43C89 36.37 94.37 31 101 31H155C161.63 31 167 36.37 167 43V199.45L138.45 176.1C132.34 171.1 123.66 171.1 117.55 176.1L89 199.45V43Z"
                                                  Fill="{DynamicResource FocusBorderBrush}"/>
                                            <Path Data="M101 31H155C161.63 31 167 36.37 167 43V67H89V43C89 36.37 94.37 31 101 31Z"
                                                  Fill="{DynamicResource DialogAccentButtonFocusBackgroundBrush}"/>
                                            <Path Data="M106 76H150"
                                                  Stroke="{DynamicResource SelectedBackgroundBrush}"
                                                  StrokeThickness="10"
                                                  StrokeLineCap="Round"/>
                                            <Path Data="M106 101H138"
                                                  Stroke="{DynamicResource SelectedBackgroundBrush}"
                                                  StrokeThickness="10"
                                                  StrokeLineCap="Round"
                                                  Opacity="0.82"/>
                                            <Path Data="M139 176.56L167 199.45V43C167 36.37 161.63 31 155 31H142V170.22C142 172.69 140.9 174.99 139 176.56Z"
                                                  Fill="{DynamicResource TextPrimaryBrush}"
                                                  Opacity="0.28"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Viewbox x:Name="DefaultFolderIconPreview"
                                             Width="22"
                                             Height="22"
                                             IsHitTestVisible="False">
                                        <Canvas Width="256"
                                                Height="256">
                                            <Path Data="M28 78C28 63.64 39.64 52 54 52H98.34C105.78 52 112.85 55.19 117.78 60.76L130.96 75.64C133.24 78.21 136.51 79.69 139.95 79.69H210C224.36 79.69 236 91.33 236 105.69V186C236 200.36 224.36 212 210 212H54C39.64 212 28 200.36 28 186V78Z"
                                                  Fill="{DynamicResource ActionOpenBrush}"/>
                                            <Path Data="M28 92C28 77.64 39.64 66 54 66H99.1C105.16 66 110.98 68.31 115.39 72.42L128.43 84.57C132.85 88.69 138.66 91 144.7 91H210C224.36 91 236 102.64 236 117V190C236 204.36 224.36 216 210 216H54C39.64 216 28 204.36 28 190V92Z"
                                                  Fill="{DynamicResource FocusBorderBrush}"/>
                                            <Path Data="M39 106C39 98.27 45.27 92 53 92H211C218.73 92 225 98.27 225 106V187C225 194.73 218.73 201 211 201H53C45.27 201 39 194.73 39 187V106Z"
                                                  Fill="{DynamicResource DialogAccentButtonFocusBackgroundBrush}"/>
                                            <Path Data="M50 114C50 109.58 53.58 106 58 106H202C206.42 106 210 109.58 210 114V119H50V114Z"
                                                  Fill="{DynamicResource SelectedBackgroundBrush}"
                                                  Opacity="0.55"/>
                                            <Path Data="M54 216H210C224.36 216 236 204.36 236 190V178C221.55 190.93 202.9 198 183.51 198H49.95C42.37 198 35.22 194.48 30.6 188.47C32.51 200.94 43.28 216 54 216Z"
                                                  Fill="{DynamicResource TextPrimaryBrush}"
                                                  Opacity="0.22"/>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DefaultIconTextBlock"
                                       Classes="iconChoiceLabel"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UploadedIconButton"
                            Classes="iconChoice"
                            Margin="0,0,8,8"
                            IsVisible="False"
                            Click="OnUploadedIconClick">
                        <StackPanel Spacing="6"
                                    HorizontalAlignment="Center">
                            <Border Classes="iconPreview">
                                <Image x:Name="UploadedIconImage"
                                       Width="22"
                                       Height="22"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="UploadedIconTextBlock"
                                       Classes="iconChoiceLabel"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UploadIconButton"
                            Classes="iconChoice"
                            Margin="0,0,8,8"
                            Click="OnUploadIconClick">
                        <StackPanel Spacing="6"
                                    HorizontalAlignment="Center">
                            <Border Classes="iconPreview">
                                <TextBlock Classes="iconPreviewGlyph"
                                           Text="+"/>
                            </Border>
                            <TextBlock x:Name="UploadIconTextBlock"
                                       Classes="iconChoiceLabel"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                </StackPanel>

                <StackPanel x:Name="UrlFieldPanel"
                            Spacing="6">
                <TextBlock Text="{x:Static localization:UiStrings.BookmarkEditorUrlLabel}"
                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                <TextBox x:Name="UrlTextBox"
                         PlaceholderText="{x:Static localization:UiStrings.BookmarkEditorUrlPlaceholder}"
                         TextChanged="OnUrlTextChanged"/>
                </StackPanel>

                <StackPanel Spacing="6">
                <TextBlock Text="{x:Static localization:UiStrings.BookmarkEditorTitleLabel}"
                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                <TextBox x:Name="TitleTextBox"/>
                <ProgressBar x:Name="MetadataLoadingIndicator"
                             Classes="metadataLoading"
                             IsVisible="False"
                             IsIndeterminate="True"
                             Height="3"/>
                <Button x:Name="MetadataSuggestionButton"
                        Classes="metadataSuggestion"
                        IsVisible="False"
                        Click="OnMetadataSuggestionClick">
                    <TextBlock x:Name="MetadataSuggestionTextBlock"
                               Classes="metadataSuggestionText"
                               TextTrimming="CharacterEllipsis"/>
                </Button>
                </StackPanel>

                <views:StatusBanner x:Name="ErrorBanner"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Classes="dialogButton"
                            Click="OnCancelClick">
                        <TextBlock Text="{x:Static localization:UiStrings.CommonCancel}"/>
                    </Button>
                    <Button x:Name="SaveButton"
                            Classes="dialogButton accent"
                            Click="OnSaveClick">
                        <TextBlock Text="{x:Static localization:UiStrings.CommonAdd}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
