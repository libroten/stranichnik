<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="using:Stranichnik.Localization"
        x:Class="Stranichnik.Views.BookmarkEditorDialog"
        Title="{x:Static localization:UiStrings.BookmarkEditorAddBookmarkTitle}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="PlaceholderForeground" Value="{DynamicResource PlaceholderTextBrush}"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogInputBorderBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource DialogButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.dialogButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton:focus">
            <Setter Property="Background" Value="{DynamicResource DialogButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.dialogButton.accent:focus">
            <Setter Property="Background" Value="{DynamicResource DialogAccentButtonFocusBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DialogAccentButtonHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="Button.metadataSuggestion">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.metadataSuggestion:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource UrlHoverTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.metadataSuggestionText">
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextDecorations">
                <TextDecorationCollection>
                    <TextDecoration Location="Underline"
                                    Stroke="{DynamicResource TextMutedBrush}"
                                    StrokeDashArray="2,2"
                                    StrokeThickness="1"/>
                </TextDecorationCollection>
            </Setter>
        </Style>
        <Style Selector="Button.metadataSuggestion:pointerover TextBlock.metadataSuggestionText">
            <Setter Property="Foreground" Value="{DynamicResource UrlHoverTextBrush}"/>
            <Setter Property="TextDecorations">
                <TextDecorationCollection>
                    <TextDecoration Location="Underline"
                                    Stroke="{DynamicResource UrlUnderlineBrush}"
                                    StrokeDashArray="2,2"
                                    StrokeThickness="1"/>
                </TextDecorationCollection>
            </Setter>
        </Style>
        <Style Selector="ProgressBar.metadataLoading">
            <Setter Property="Background" Value="{DynamicResource DialogInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FocusBorderBrush}"/>
        </Style>
    </Window.Styles>

    <Border Padding="20"
            Background="{DynamicResource DialogBackgroundBrush}">
        <StackPanel Spacing="14">
            <TextBlock x:Name="DialogTitleTextBlock"
                       Text="{x:Static localization:UiStrings.BookmarkEditorAddBookmarkTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DialogTextPrimaryBrush}"/>

            <StackPanel x:Name="UrlFieldPanel"
                        Spacing="6">
                <TextBlock Text="{x:Static localization:UiStrings.BookmarkEditorUrlLabel}"
                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                <TextBox x:Name="UrlTextBox"
                         PlaceholderText="{x:Static localization:UiStrings.BookmarkEditorUrlPlaceholder}"
                         TextChanged="OnUrlTextChanged"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static localization:UiStrings.BookmarkEditorTitleLabel}"
                           Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                <TextBox x:Name="TitleTextBox"/>
                <ProgressBar x:Name="MetadataLoadingIndicator"
                             Classes="metadataLoading"
                             IsVisible="False"
                             IsIndeterminate="True"
                             Height="3"/>
                <Button x:Name="MetadataSuggestionButton"
                        Classes="metadataSuggestion"
                        IsVisible="False"
                        Click="OnMetadataSuggestionClick">
                    <TextBlock x:Name="MetadataSuggestionTextBlock"
                               Classes="metadataSuggestionText"
                               TextTrimming="CharacterEllipsis"/>
                </Button>
            </StackPanel>

            <TextBlock x:Name="ErrorTextBlock"
                       IsVisible="False"
                       Foreground="{DynamicResource TextErrorBrush}"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Classes="dialogButton"
                        Click="OnCancelClick">
                    <TextBlock Text="{x:Static localization:UiStrings.CommonCancel}"/>
                </Button>
                <Button x:Name="SaveButton"
                        Classes="dialogButton accent"
                        Click="OnSaveClick">
                    <TextBlock Text="{x:Static localization:UiStrings.CommonAdd}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
