<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Stranichnik.App"
             xmlns:local="using:Stranichnik"
             RequestedThemeVariant="Light">
             <!-- The app currently uses a custom light UI, so built-in controls should also use the light theme. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
